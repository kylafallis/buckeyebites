# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Scripts only (sync, import, demo). Never use in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the recipe dupe falls back to the rule-based matcher without it.
GEMINI_API_KEY=
# Google Sheet ID for scripts/sync-sheet.ts
MENU_SHEET_ID=
